[database]
# Embedded by default: one file, no server, no setup. This is the right
# choice for a solo install and is *faster* than Postgres for it — neither
# backend has a vector index yet, so both scan linearly, and an in-process
# store skips the socket + driver overhead. Measured at 152k vectors, k=10:
# 87.5ms (sqlite-vec) vs 150.3ms (pgvector).
#
# Omit this key entirely and hafiz uses the same location by default —
# $XDG_DATA_HOME/hafiz/hafiz.db, falling back to ~/.local/share.
url = "sqlite:///~/.local/share/hafiz/hafiz.db"

# Postgres stays first-class, and is the right answer when several machines
# or several people share one brain. Requires the pgvector extension.
# url = "postgresql+asyncpg://postgres:postgres@localhost:5432/hafiz"
#
# Moving between the two: `hafiz migrate-backend --to <url>` copies every
# table, verifies the row counts and round-trips a vector. Do not "just
# re-ingest" — that recovers code and docs, which git can regenerate, but
# your annotations have no source to re-derive from.

[embedding]
model = "nomic-ai/nomic-embed-text-v1.5"
provider = "fastembed"   # fastembed | openai | ollama
dimensions = 768
# Device selection for local ONNX embedding. Three modes:
#   "auto" (default) — probe CUDA once, fall back to CPU if it fails;
#                      the outcome is cached at ~/.cache/hafiz/device_state.json.
#                      Use `hafiz embedding retry` after freeing VRAM to re-probe.
#   "cpu"            — never touch the GPU (ideal on shared workstations where
#                      other processes, e.g. LM Studio, hold VRAM).
#   "gpu"            — require CUDA; fail loudly if it doesn't work.
# Env override: HAFIZ_EMBEDDING__DEVICE=cpu
device = "auto"
# Max characters per embedding part. ONNX attention is O(n²) in sequence
# length, so long parts blow up memory on CPU. The 2_000-char default
# (~512 tokens) is CPU-safe on a 16 GB laptop. GPU hosts can raise this
# to 16_000+ via `hafiz config set embedding.max_part_chars 16000` or
# `hafiz doctor --apply` once the self-tuning prober lands.
# Env override: HAFIZ_EMBEDDING__MAX_PART_CHARS=4096
max_part_chars = 2000

[rerank]
# Cross-encoder reranking of `query --recall` results — a second-stage
# precision pass that sharply separates relevant rows from near-random
# noise. On by default. The model ships with fastembed (no extra
# dependency) and loads lazily. Disable on constrained hosts.
# Env override: HAFIZ_RERANK__ENABLED=false
enabled = true
model = "Xenova/ms-marco-MiniLM-L-6-v2"  # ~80 MB ONNX cross-encoder
# Over-fetch this multiple of the requested limit before reranking, so the
# cross-encoder has real candidates to reorder.
candidate_multiplier = 3

[dedup]
# Near-duplicate detection on `observe` (not `note`). Before writing, Hafiz
# cosine-compares the new annotation against live rows of the same kind +
# project and surfaces any at/above `threshold`. It detects *similarity*, not
# *contradiction* — the supersede/refine/distinct call stays with the caller.
# Env override: HAFIZ_DEDUP__ENABLED=false
enabled = true
# Cosine similarity at/above which a live row counts as a near-duplicate.
# 0.88 catches genuine restatements while leaving distinct-but-related facts
# (typically 0.80–0.87) alone.
threshold = 0.88
# Surface-only (false) = the write always succeeds and duplicates ride back.
# Strict (true) = a match aborts the write unless --supersedes or
# --allow-duplicate is given. Off by default — a gate that can't tell
# "contradicts" from "merely similar" trains callers to reflexively bypass it.
# Env override: HAFIZ_DEDUP__STRICT=true
strict = false
# Cap on how many duplicates to surface per write.
max_candidates = 5

[annotations]
# Soft size brake on `observe` (not `note`). `kind` is the only schema an
# annotation has, so decision + rationale + scope + rejected-alternatives tend
# to end up in one prose blob — which is injected whole at recall, gets a
# single embedding averaging several unrelated topics, and defeats blob-to-blob
# duplicate detection. Above this many characters, `observe` prints a hint and
# sets `oversized` in --json. Advisory only: the write always succeeds.
# 1500 is ~p90 on a real store — it fires on the long tail, not the median.
# Set to 0 to disable. Env override: HAFIZ_ANNOTATIONS__MAX_RECOMMENDED_CHARS=0
max_recommended_chars = 1500
# The read-side half: how much of a record `--format compact` and `--format md`
# inject. Those two exist to be piped into a prompt; `json` and `rich` always
# carry the full text, so nothing is unreachable. Records at or under this pass
# through whole. Excerpts are marked (`excerpt: true` / "excerpt of N chars").
# Measured: a --observations --limit 20 recall went 18,839 -> 6,495 bytes
# (~-65%) for ~+0.5s. Set to 0 to always inject full records.
# Env override: HAFIZ_ANNOTATIONS__SNIPPET_CHARS=0
snippet_chars = 480

[distill]
# How the promotable backlog is assembled. `distill` stays a scanner and never
# calls an LLM — "automatic" means the backlog drains, groups and surfaces
# itself, not that beliefs get written for you.
#
# Cosine similarity at/above which two captures land in the same theme.
# Deliberately far below [dedup] threshold (0.88): dedup asks "is this the same
# claim restated?", clustering asks "are these about the same thing?". A theme
# is a much looser join, and at 0.88 essentially nothing groups.
# Env override: HAFIZ_DISTILL__CLUSTER_THRESHOLD=0.7
cluster_threshold = 0.65
# Cap on source-layer turns pulled into the window, taken salient-first then
# newest. Env override: HAFIZ_DISTILL__MESSAGE_LIMIT=100
message_limit = 50
# `--brief` gate. It prints NOTHING unless the backlog has at least this many
# pending captures OR one that has waited this long — either condition fires
# it. `--brief` is built for a session-start hook, so silence must be the
# ordinary answer or the hook gets removed.
# Env override: HAFIZ_DISTILL__BRIEF_MIN_PENDING=5
brief_min_pending = 3
brief_min_age_days = 2.0
# How much `--brief` renders. It has to stay cheap enough to inject every
# session; anything dropped is stated in the output, never silently.
brief_max_themes = 5
brief_max_members = 4

[ingest]
# Skip any file larger than this (bytes). Guards against minified
# bundles, generated output, and accidentally-committed binaries that
# can slip past the binary-content probe and OOM the embedder.
# Env override: HAFIZ_INGEST__MAX_FILE_BYTES=4194304
max_file_bytes = 2097152  # 2 MB

[daemon]
# The warm daemon (`hafiz serve`) keeps the embedding model and DB pool hot.
# `hafiz query --observations` and `hafiz context` spawn it on demand and fall
# back to running in-process if anything goes wrong, so it can only make calls
# faster, never break them. Measured on a 1,900-annotation store: 0.8s warm vs
# 1.8s cold, because the warm path skips the ~0.9s fastembed model load.
#
# Seconds of inactivity before the daemon exits.
#
# SET THIS TO 0 TO KEEP IT HOT INDEFINITELY. That's the right choice when
# something consumes hafiz continuously (an editor plugin, a service, an agent
# loop): with a 30-minute shutdown, every quiet spell costs the model load
# again on the next request. Leave it at 1800 on a laptop that runs the odd
# query and would rather have the memory back.
#
# Precedence: `serve --idle-timeout` > HAFIZ_DAEMON_IDLE > this > 1800.
# Disable the daemon entirely with HAFIZ_NO_DAEMON=1.
idle_timeout = 1800  # 30 minutes; 0 = never shut down

[telemetry]
# Record every search locally (the `retrievals` table), so the store can be
# evaluated: what's never recalled, what's recalled constantly, and — most
# usefully — what was asked for and NOT found. Read it with `hafiz retrievals`.
#
# This is the only place hafiz stores what you were *looking for* rather than
# what you concluded. It never leaves the machine, it's bounded by
# retention_days, `hafiz forget --all-expired` sweeps it, and `hafiz status`
# counts the backlog. Set to false to record nothing.
# Env override: HAFIZ_TELEMETRY__RETRIEVAL=false
retrieval = true
retention_days = 90
# Queries shorter than this aren't recorded — "ok" / "yes" say nothing about
# what the store was asked for.
min_query_chars = 3

[workspace]
root = "/path/to/your/workspace"
projects = ["project-a", "project-b"]
ignore = [".git", "node_modules", "__pycache__", ".venv", "dist", "build", ".tox", ".mypy_cache", ".ruff_cache", "*.pyc", "*.pyo"]

[graph]
# How many hops to walk from entities found in the retrieved chunks (undirected).
context_depth = 3
# Hard cap on entities included in the context bundle, sorted by (distance, -pagerank).
context_max_entities = 25
