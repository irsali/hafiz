[database]
url = "postgresql+asyncpg://postgres:postgres@localhost:5432/hafiz"

[embedding]
model = "nomic-ai/nomic-embed-text-v1.5"
provider = "fastembed"   # fastembed | openai | ollama
dimensions = 768
# Device selection for local ONNX embedding. Three modes:
#   "auto" (default) — probe CUDA once, fall back to CPU if it fails;
#                      the outcome is cached at ~/.cache/hafiz/device_state.json.
#                      Use `hafiz embedding retry` after freeing VRAM to re-probe.
#   "cpu"            — never touch the GPU (ideal on shared workstations where
#                      other processes, e.g. LM Studio, hold VRAM).
#   "gpu"            — require CUDA; fail loudly if it doesn't work.
# Env override: HAFIZ_EMBEDDING__DEVICE=cpu
device = "auto"

[workspace]
root = "/path/to/your/workspace"
projects = ["project-a", "project-b"]
ignore = [".git", "node_modules", "__pycache__", ".venv", "dist", "build", ".tox", ".mypy_cache", ".ruff_cache", "*.pyc", "*.pyo"]

[graph]
# How many hops to walk from entities found in the retrieved chunks (undirected).
context_depth = 3
# Hard cap on entities included in the context bundle, sorted by (distance, -pagerank).
context_max_entities = 25
