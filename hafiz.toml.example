[database]
url = "postgresql+asyncpg://postgres:postgres@localhost:5432/hafiz"

[embedding]
model = "nomic-ai/nomic-embed-text-v1.5"
provider = "fastembed"   # fastembed | openai | ollama
dimensions = 768
# Device selection for local ONNX embedding. Three modes:
#   "auto" (default) — probe CUDA once, fall back to CPU if it fails;
#                      the outcome is cached at ~/.cache/hafiz/device_state.json.
#                      Use `hafiz embedding retry` after freeing VRAM to re-probe.
#   "cpu"            — never touch the GPU (ideal on shared workstations where
#                      other processes, e.g. LM Studio, hold VRAM).
#   "gpu"            — require CUDA; fail loudly if it doesn't work.
# Env override: HAFIZ_EMBEDDING__DEVICE=cpu
device = "auto"
# Max characters per embedding part. ONNX attention is O(n²) in sequence
# length, so long parts blow up memory on CPU. The 2_000-char default
# (~512 tokens) is CPU-safe on a 16 GB laptop. GPU hosts can raise this
# to 16_000+ via `hafiz config set embedding.max_part_chars 16000` or
# `hafiz doctor --apply` once the self-tuning prober lands.
# Env override: HAFIZ_EMBEDDING__MAX_PART_CHARS=4096
max_part_chars = 2000

[rerank]
# Cross-encoder reranking of `query --recall` results — a second-stage
# precision pass that sharply separates relevant rows from near-random
# noise. On by default. The model ships with fastembed (no extra
# dependency) and loads lazily. Disable on constrained hosts.
# Env override: HAFIZ_RERANK__ENABLED=false
enabled = true
model = "Xenova/ms-marco-MiniLM-L-6-v2"  # ~80 MB ONNX cross-encoder
# Over-fetch this multiple of the requested limit before reranking, so the
# cross-encoder has real candidates to reorder.
candidate_multiplier = 3

[dedup]
# Near-duplicate detection on `observe` (not `note`). Before writing, Hafiz
# cosine-compares the new annotation against live rows of the same kind +
# project and surfaces any at/above `threshold`. It detects *similarity*, not
# *contradiction* — the supersede/refine/distinct call stays with the caller.
# Env override: HAFIZ_DEDUP__ENABLED=false
enabled = true
# Cosine similarity at/above which a live row counts as a near-duplicate.
# 0.88 catches genuine restatements while leaving distinct-but-related facts
# (typically 0.80–0.87) alone.
threshold = 0.88
# Surface-only (false) = the write always succeeds and duplicates ride back.
# Strict (true) = a match aborts the write unless --supersedes or
# --allow-duplicate is given. Off by default — a gate that can't tell
# "contradicts" from "merely similar" trains callers to reflexively bypass it.
# Env override: HAFIZ_DEDUP__STRICT=true
strict = false
# Cap on how many duplicates to surface per write.
max_candidates = 5

[ingest]
# Skip any file larger than this (bytes). Guards against minified
# bundles, generated output, and accidentally-committed binaries that
# can slip past the binary-content probe and OOM the embedder.
# Env override: HAFIZ_INGEST__MAX_FILE_BYTES=4194304
max_file_bytes = 2097152  # 2 MB

[telemetry]
# Record every search locally (the `retrievals` table), so the store can be
# evaluated: what's never recalled, what's recalled constantly, and — most
# usefully — what was asked for and NOT found. Read it with `hafiz retrievals`.
#
# This is the only place hafiz stores what you were *looking for* rather than
# what you concluded. It never leaves the machine, it's bounded by
# retention_days, `hafiz forget --all-expired` sweeps it, and `hafiz status`
# counts the backlog. Set to false to record nothing.
# Env override: HAFIZ_TELEMETRY__RETRIEVAL=false
retrieval = true
retention_days = 90
# Queries shorter than this aren't recorded — "ok" / "yes" say nothing about
# what the store was asked for.
min_query_chars = 3

[workspace]
root = "/path/to/your/workspace"
projects = ["project-a", "project-b"]
ignore = [".git", "node_modules", "__pycache__", ".venv", "dist", "build", ".tox", ".mypy_cache", ".ruff_cache", "*.pyc", "*.pyo"]

[graph]
# How many hops to walk from entities found in the retrieved chunks (undirected).
context_depth = 3
# Hard cap on entities included in the context bundle, sorted by (distance, -pagerank).
context_max_entities = 25
